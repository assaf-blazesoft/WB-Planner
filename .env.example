# Supabase — copy from: Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Netlify function base URL (for local dev with netlify dev)
# Leave blank for production — Netlify resolves /.netlify/functions automatically
VITE_FUNCTIONS_URL=

# Netlify function env vars (set in Netlify dashboard → Environment Variables)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@yourdomain.com
APP_URL=https://your-app.netlify.app
